# ===== 服务 =====
PORT=3000
NODE_ENV=development

# ===== 数据库 / 缓存 =====
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=music
DB_PASSWORD=music_password
DB_DATABASE=musicdb
REDIS_URL=redis://redis:6379

# ===== JWT =====
# 生产环境务必替换为强随机串（>= 32 字符）
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_TTL_DAYS=30

# ===== 认证 Mock 开关 =====
# true  = 微信/SMS 走 Mock（无企业资质联调）
# false = 调真实微信 code2session 与真实短信通道
AUTH_MOCK=true
SMS_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=
# 真实短信通道扩展点（aliyun / tencent / mock）
SMS_PROVIDER=mock

# ===== 对象存储预签名 =====
STORAGE_PROVIDER=oss          # oss | cos
SIGNED_URL_TTL=3600          # 预签名 URL 有效期（秒）

# 阿里云 OSS
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=                       # 可选，自定义 endpoint

# 腾讯云 COS
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
