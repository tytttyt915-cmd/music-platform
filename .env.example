# ===== 复制为 .env 后填入真实值，勿提交到 Git =====
# 数据库
DB_NAME=musicdb
DB_USER=music
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 后端
PORT=3000
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=2592000

# 认证 Mock 降级开关（无企业资质联调时设为 true）
AUTH_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=
SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 对象存储（二选一）
STORAGE_PROVIDER=oss            # oss | cos
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# 预签名 URL 有效期（秒）
SIGNED_URL_TTL=600

# Nginx
NGINX_HTTP_PORT=80
