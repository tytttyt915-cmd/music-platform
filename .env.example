# ===== 复制为 .env 后填入真实值，勿提交到 Git =====
# 数据库
DB_NAME=musicdb
DB_USER=music
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis（后端优先读 REDIS_URL；不填则按 REDIS_HOST/PORT/PASSWORD 自动拼接）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# REDIS_URL=redis://:<密码>@redis:6379

# 后端
PORT=3000
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
JWT_EXPIRES_IN=3600
REFRESH_EXPIRES_IN=2592000

# 认证 Mock 降级开关（无企业资质联调时设为 true）
AUTH_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=
SMS_PROVIDER=mock
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# 对象存储（二选一）
STORAGE_PROVIDER=none           # oss | cos | none（none=未配存储也能启动，仅音频流返回503）
OSS_REGION=oss-cn-shanghai
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
COS_REGION=ap-shanghai
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
# 预签名 URL 有效期（秒）
SIGNED_URL_TTL=600

# Nginx
NGINX_HTTP_PORT=80

# 第三方免费音乐 API（全都不用 key；单个挂了只降级不影响主流程）
LYRICSOVH_ENABLED=true
LYRICSOVH_BASE_URL=https://api.lyrics.ovh
LYRICSOVH_TIMEOUT_MS=5000
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_BASE_URL=https://musicbrainz.org
MUSICBRAINZ_USER_AGENT=music-platform/1.0
MUSICBRAINZ_TIMEOUT_MS=5000
ITUNES_ENABLED=true
ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRY=US
ITUNES_TIMEOUT_MS=5000
ITUNES_MAX_RESULTS=5
