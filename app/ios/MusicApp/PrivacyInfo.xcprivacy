<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  隐私清单（Privacy Manifest），苹果强制要求（2024 年 5 月 1 日起）。
  本 App 不收集任何可用于追踪的数据；账号数据仅存储于自有后端，
  因此 NSPrivacyCollectedDataTypes 为空数组。
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1：经用户授权的 App 功能所需，读取/写入用户偏好与登录态 -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 35F9.1：测量音频播放链路耗时、排查后台播放异常 -->
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1：管理音频缓存文件的写入顺序与过期清理 -->
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1：向用户展示设备剩余空间，决定音频缓存配额 -->
				<string>E174.1</string>
			</array>
		</dict>
	</array>
	<!-- 本 App 不收集可追踪数据：账号数据仅存自有后端，不上传第三方 -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
